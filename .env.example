# Healthcare Knowledge Base System - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION
# =============================================================================
# APP_ENV options: development, staging, production, demo
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/knowledge_base

# =============================================================================
# LITELLM GATEWAY (Cloud - REQUIRED)
# =============================================================================
# Your cloud LiteLLM instance URL
LITELLM_BASE_URL=https://your-litellm-instance.com
LITELLM_API_KEY=sk-your-litellm-api-key

# =============================================================================
# AWS CONFIGURATION (For Titan Embeddings & Bedrock)
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# =============================================================================
# EMBEDDINGS (AWS Titan - New Default)
# =============================================================================
EMBEDDING_PROVIDER=titan
TITAN_MODEL_ID=amazon.titan-embed-text-v2:0
TITAN_NORMALIZE=true
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=25

# =============================================================================
# VECTOR STORE (OpenSearch - New Default)
# =============================================================================
VECTOR_STORE_PROVIDER=opensearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX_NAME=knowledge_base_vectors
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# OpenSearch k-NN Parameters (for vector search optimization)
OPENSEARCH_KNN_EF_SEARCH=100
OPENSEARCH_KNN_M=16
OPENSEARCH_KNN_EF_CONSTRUCTION=100

# =============================================================================
# RETRIEVAL CONFIGURATION
# =============================================================================
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.7

# =============================================================================
# DOCUMENT PROCESSING
# =============================================================================
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# =============================================================================
# REDIS (Caching & Rate Limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Admin Login (for development - use AWS Secrets Manager in production)
ADMIN_PASSWORD=admin123
COOKIE_SECRET=dev-secret-key-change-in-prod

# Google OAuth (for future HTTPS deployment)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# SECURITY
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# =============================================================================
# LEGACY / OPTIONAL (Not required for new deployments)
# =============================================================================
# Cohere (kept as fallback option)
COHERE_API_KEY=

# Qdrant (legacy - not needed for new deployments)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=knowledge_base

# Web Harvester (future phase)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
FIRECRAWL_API_KEY=
WEB_HARVEST_RETENTION_DAYS=90

# Case Note API — the old synchronous service. The Case Note page no longer calls it directly
# (see MMR_API_BASE_URL below); these remain for testing that service on its own.
CASE_NOTE_API_BASE_URL=<CASE_NOTE_API_URL>/api/v1
CASE_NOTE_API_USERNAME=demo
CASE_NOTE_API_PASSWORD=

# mmr-api — brokers the async case-note service for the Case Note page: it submits on our behalf
# and parks the webhook-delivered note for us to collect. The token must match the value mmr-api
# holds under the same name (CASE_NOTE_DAP_KMS_TOKEN).
MMR_API_BASE_URL=
CASE_NOTE_DAP_KMS_TOKEN=
