.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================================================
# Docker
# =============================================================================
docker/data/
*.log

# =============================================================================
# Application Specific
# =============================================================================
# Uploads directory (but keep .gitkeep)
uploads/*
!uploads/.gitkeep

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Database files (local development)
*.db
*.sqlite
*.sqlite3

# Vector store data (local)
qdrant_data/

# =============================================================================
# Infrastructure (Terraform/CDK)
# =============================================================================
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
!infrastructure/terraform/envs/*.tfvars
.terraform.lock.hcl
cdk.out/

# =============================================================================
# Alembic
# =============================================================================
alembic/versions/*.pyc

# =============================================================================
# Misc
# =============================================================================
*.bak
.cache/
scratchpad/

# Terraform
infrastructure/terraform/.terraform/
infrastructure/terraform/tfplan
infrastructure/terraform/terraform-apply.log
infrastructure/terraform/terraform.tfvars
# Local backend configs with real account IDs (templates without IDs are committed)
infrastructure/terraform/backends/*.local.hcl
*.tfstate
*.tfstate.*

# Production setup — contains secrets, never commit
infrastructure/prod.env
